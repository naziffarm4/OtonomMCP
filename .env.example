# ==============================================================================
# OtonomMCP (AIDM) — Environment Configuration Template
# ==============================================================================
# IMPORTANT: Never commit actual API keys or secrets to version control.
# Copy this file to .env and provide your local credentials.

# ------------------------------------------------------------------------------
# 1. LLM Provider & Authentication
# ------------------------------------------------------------------------------
# AIDM_LLM_API_KEY takes precedence over OPENAI_API_KEY when both are set.
AIDM_LLM_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 2. LLM Endpoints & Routing
# ------------------------------------------------------------------------------
# AIDM_LLM_ENDPOINT: Full dispatch URL (e.g., https://api.openai.com/v1/chat/completions)
# OPENAI_BASE_URL: Base URL for OpenAI-compatible providers (e.g., https://api.openai.com)
# Precedence: Explicit config > AIDM_LLM_ENDPOINT > OPENAI_BASE_URL > Default
AIDM_LLM_ENDPOINT=
OPENAI_BASE_URL=

# ------------------------------------------------------------------------------
# 3. Model Selection
# ------------------------------------------------------------------------------
# AIDM_LLM_MODEL takes precedence over OPENAI_MODEL when both are set.
# Default: 'gpt-4o' for openai.com endpoints, 'director-reasoning-v1' for internal adapters.
AIDM_LLM_MODEL=
OPENAI_MODEL=

# ------------------------------------------------------------------------------
# 4. MCP Server Security
# ------------------------------------------------------------------------------
# Optional token for MCP client/server authentication and handshake validation.
AIDM_MCP_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 5. Runtime Environment Mode
# ------------------------------------------------------------------------------
# Values: 'development' | 'production' | 'test'
# In 'production', DirectorRuntime strictly rejects mock providers and fails closed.
NODE_ENV=development

# ------------------------------------------------------------------------------
# 6. Antigravity CLI Execution Boundary
# ------------------------------------------------------------------------------
# Optional path overrides for the Antigravity CLI binary (`agy` or `agy.exe`).
# If unset, the CLI is discovered from system PATH.
ANTIGRAVITY_BIN_PATH=
AGY_BIN_PATH=
AGY_PATH=

# ------------------------------------------------------------------------------
# 7. Testing & Verification Gates
# ------------------------------------------------------------------------------
# Set to '1' to enable live E2E tests (real LLM API & real host agy execution).
# Default test runs (pnpm test) ignore this and remain 100% deterministic and offline.
AIDM_LIVE_E2E=0
