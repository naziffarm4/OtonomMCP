{
  "name": "ai-development-manager-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @aidm/core build",
    "typecheck": "pnpm --filter @aidm/core typecheck",
    "typecheck:tests": "pnpm --filter @aidm/core typecheck:tests",
    "test": "pnpm --filter @aidm/core test",
    "test:live": "pnpm --filter @aidm/core test:live",
    "lint": "eslint .",
    "aidm": "node packages/core/bin/aidm.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "eslint": "^10.12.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.1"
  },
  "packageManager": "pnpm@12.3.4"
}
