# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit LF for source, doc, and config files
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.env.example text eol=lf
.nvmrc text eol=lf

# PowerShell and Windows specific command scripts
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
